# docker
alias docki="docker inspect"                                                    # display the information about a container
alias docke='docker exec -t -i'                                                 # going inside a container
function dockrm() {
  echo "This will remove all Docker containers."
  read -q "confirm?Continue? [y/N] " || return 1
  echo
  docker ps -a -q | xargs -r docker rm -f
}
function dockDE() {
  echo "This will remove all Docker containers and images."
  read -q "confirm?Continue? [y/N] " || return 1
  echo
  docker ps -a -q | xargs -r docker rm -f
  docker images -q | xargs -r docker rmi
}

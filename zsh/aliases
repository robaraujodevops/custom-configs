# VPN
function _vpn_config() {
  if [ -z "$VPN_CONFIG_FILE" ]; then
    echo "VPN_CONFIG_FILE is not set. Define it in $ZDOTDIR/.zshxenv." >&2
    return 1
  fi
}
function vpn-start() {
  _vpn_config || return 1
  /usr/bin/openvpn3 session-start --config "$VPN_CONFIG_FILE"
}
function vpn-stop() {
  _vpn_config || return 1
  /usr/bin/openvpn3 session-manage --disconnect --config "$VPN_CONFIG_FILE"
}
function vpn-log() {
  _vpn_config || return 1
  /usr/bin/openvpn3 log --config "$VPN_CONFIG_FILE"
}
function vpn-stats() {
  _vpn_config || return 1
  /usr/bin/openvpn3 session-stats --config "$VPN_CONFIG_FILE"
}
alias vpn-ps="ps auxfwww | grep openvpn"
alias vpn-kill="pgrep openvpn | xargs sudo kill -9"

# Sec
function genk() {
  local pkey=~/.ssh/id_ed25519
  local keys=~/.ssh/keys

  if [[ -f "$pkey" ]]; then
    if [[ ! -d "$keys" ]]; then
      mkdir $keys
    fi
    
    cd ~/.ssh

    for key in id_ed25519*; do
      echo "$key"
      mv "$key" "$keys/${key}_$1"
    done

  fi

  ssh-keygen -o -a 100 -t ed25519 -f ~/.ssh/id_ed25519 -C "$1"
}

